---
import { Icon } from 'astro-icon/components';

interface Props {
	id: string;
	title: string;
	subtitle?: string;
	url: string;
	icon?: string;
	featured?: boolean;
}

const { title, subtitle, url, icon, featured = false } = Astro.props;
const isExternal = url.startsWith('http://') || url.startsWith('https://');
---

<a
	href={url}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener noreferrer' : undefined}
	class:list={[
		'nb-card group',
		{ 'featured-card': featured }
	]}
>
	<!-- Left Icon wrapper with solid black border and hard shadow -->
	{icon && (
		<div
			class:list={[
				'flex items-center justify-center w-11 h-11 border-[2px] border-black text-black shadow-[2px_2px_0px_#000] shrink-0 mr-3.5 transition-transform duration-100 group-hover:scale-105',
				featured ? 'bg-white' : 'bg-[#F0F7FF]'
			]}
		>
			<Icon name={icon} size="1.35em" />
		</div>
	)}

	<!-- Content text -->
	<div class="flex-1 min-w-0 pr-2">
		<span class="block font-black text-[0.95rem] uppercase tracking-tight text-black truncate">
			{title}
		</span>
		{subtitle && (
			<p class="text-xs font-mono font-medium text-[#374151] truncate mt-1 m-0">
				{subtitle}
			</p>
		)}
	</div>

	<!-- Directional arrow icon with solid border -->
	<div
		class:list={[
			'flex items-center justify-center w-8 h-8 border-[2px] border-black text-black shadow-[2px_2px_0px_#000] group-hover:bg-black group-hover:text-white transition-colors duration-100 shrink-0 ml-1',
			featured ? 'bg-white' : 'bg-[#F0F7FF]'
		]}
	>
		{isExternal ? (
			<Icon name="tabler:arrow-up-right" size="1.2em" class="stroke-[2.5]" />
		) : (
			<Icon name="tabler:arrow-right" size="1.2em" class="stroke-[2.5]" />
		)}
	</div>
</a>
